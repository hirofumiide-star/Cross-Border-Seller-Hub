{{ 'tsukino-editorial.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tsukino-tea-ui.js' | asset_url }}" defer></script>
{%- liquid
  assign language = request.locale.iso_code | downcase | split: '-' | first
  assign section_key = 'tsukino-buy-' | append: section.id
  assign campaign = section.settings
  assign demo = campaign.campaign_demo
  assign target = campaign.campaign_target_sets | default: 0 | plus: 0
  assign registered = campaign.campaign_registered_sets | default: 0 | plus: 0
  assign deadline = campaign.campaign_deadline | strip
  assign time_zone = deadline | slice: -6, 6
  assign deadline_size = deadline | size
  assign deadline_epoch = deadline | date: '%s' | plus: 0
  assign now_epoch = 'now' | date: '%s' | plus: 0
  assign campaign_ready = false
  if campaign.campaign_open and target > 0 and registered >= 0 and campaign.campaign_registered_sets != blank and deadline_size == 25 and time_zone == '+08:00' and deadline_epoch > 86400
    if campaign.campaign_url != blank and campaign.campaign_price != blank and campaign.campaign_delivery != blank and campaign.campaign_host != blank and campaign.campaign_host_note != blank and campaign.refund_terms != blank
      assign campaign_ready = true
    endif
  endif
  assign accepting = false
  if campaign_ready and deadline_epoch > now_epoch
    assign accepting = true
  endif
  assign campaign_price = campaign.campaign_price
  assign campaign_host = campaign.campaign_host
  assign campaign_note = campaign.campaign_host_note
  assign campaign_pickup = campaign.campaign_delivery
  assign payment_terms = campaign.refund_terms
  assign deadline_label = deadline | slice: 0, 16 | replace: 'T', ' ' | replace: '-', '/'
  assign public_share_url = campaign.campaign_share_url | default: canonical_url
  if campaign.campaign_share_url == blank
    assign public_share_url = public_share_url | append: '#' | append: section_key
  endif
  assign share_url_prefix = public_share_url | slice: 0, 1
  if share_url_prefix == '/'
    assign public_share_url = request.origin | append: public_share_url
  endif
  case language
    when 'ja'
      assign group = '台湾・今期の團購'
      assign title = 'ティーバッグ3種セット'
      assign desc = '宇治玉露、宇治煎茶、碾茶。台湾の團主と一緒に取り寄せる、JA全農京都の宇治茶3種セット。'
      assign heroAlt = '宇治茶のティーバッグと三つの茶碗'
      assign pre = '募集準備中'
      assign open = '受付中'
      assign closed = '受付終了'
      assign pending = '團主、価格、受付期間、台湾での受取方法が決まり次第、ここでご案内します。'
      assign join = '團購に参加する'
      assign invite = 'LINEで友達を誘う'
      assign invite_whatsapp = 'WhatsAppで友達を誘う'
      assign host_label = '今回の團主'
      assign price_label = '團購価格'
      assign deadline_name = '申込締切'
      assign pickup_label = '受取方法'
      assign zone_label = '台湾時間'
      assign progress_name = '申込セット数'
      assign progress_label = '{registered}／{target} セット申込済み'
      assign remaining_label = 'あと {remaining} セットで成立条件に到達'
      assign goal_met = '成立に必要なセット数に到達'
      assign terms = '支払いと不成立時の扱い'
      assign how = '申し込みから受け取りまで'
      assign steps = '團主のページから申し込む|締切後に成立を確認し、支払いの案内を受け取る|日本から台湾の團主へまとめて発送|團主の案内に沿って台湾で受け取る' | split: '|'
      assign demo_label = 'デモ · 実際の募集ではありません'
      assign demo_join = '本番では團主の申込ページに進みます。このデモでは登録・決済は発生しません。'
      assign demo_invite = '本番ではこの募集ページをLINEで共有します。こちらは招待文の表示例です。'
      assign demo_invite_whatsapp = '本番ではこの募集ページをWhatsAppで共有します。こちらは招待文の表示例です。'
      assign demo_date = '12月6日（日）22:00'
      assign demo_host = '台北の林さん（デモ團主）'
      assign demo_pickup = '台北・対面受取'
      assign demo_note = 'まずは宇治煎茶から。宇治玉露と碾茶も淹れて、三種類を飲み比べてみてください。'
      assign demo_terms = '成團後に支払いのご案内を受け取ります。不成立の場合、支払いはありません。'
      assign share_intro = '台湾で宇治茶を一緒に取り寄せませんか？'
      assign image_label = 'AI生成のイメージ'
    when 'en'
      assign group = 'Taiwan · current group buy'
      assign title = 'Three Uji Tea Bag Varieties'
      assign desc = 'Uji gyokuro, Uji sencha, and tencha. Explore three Japanese teas from JA Zen-Noh Kyoto through our Taiwan group buy.'
      assign heroAlt = 'Three cups of Uji tea with tea bags'
      assign pre = 'In preparation'
      assign open = 'Open for signups'
      assign closed = 'Signups closed'
      assign pending = 'We’ll announce the organizer, price, signup dates, and Taiwan pickup details here.'
      assign join = 'Join the group buy'
      assign invite = 'Invite friends on LINE'
      assign invite_whatsapp = 'Invite friends on WhatsApp'
      assign host_label = 'Your group organizer'
      assign price_label = 'Group-buy price'
      assign deadline_name = 'Signup deadline'
      assign pickup_label = 'Pickup method'
      assign zone_label = 'Taiwan time'
      assign progress_name = 'Sets registered'
      assign progress_label = '{registered} of {target} sets registered'
      assign remaining_label = '{remaining} more to reach the minimum'
      assign goal_met = 'Minimum quantity reached'
      assign terms = 'Payment and what happens if the group falls short'
      assign how = 'From signup to pickup'
      assign steps = 'Sign up through the organizer|After the deadline, get the outcome and payment instructions|One shipment travels from Japan to the organizer in Taiwan|Follow the organizer’s instructions to receive your tea in Taiwan' | split: '|'
      assign demo_label = 'Demo · Sample campaign'
      assign demo_join = 'The organizer’s signup page opens here in an active campaign. This demo does not collect registrations or payments.'
      assign demo_invite = 'In an active campaign, this shares the group-buy page on LINE. Here is an example invitation.'
      assign demo_invite_whatsapp = 'In an active campaign, this shares the group-buy page on WhatsApp. Here is an example invitation.'
      assign demo_date = 'Sunday, Dec 6 at 22:00'
      assign demo_host = 'Lin in Taipei (demo organizer)'
      assign demo_pickup = 'Taipei · in-person pickup'
      assign demo_note = 'Start with Uji sencha, then brew the gyokuro and tencha side by side.'
      assign demo_terms = 'We send payment instructions if the group buy goes ahead. No payment is due if it falls short.'
      assign share_intro = 'Let’s order a Japanese tea tasting set together.'
      assign image_label = 'AI-generated illustration'
    else
      assign group = '台灣・本期開團'
      assign title = '宇治茶包三款組'
      assign desc = '宇治玉露、宇治煎茶與碾茶。跟著台灣團主，一起認識 JA 全農京都的三款宇治茶。'
      assign heroAlt = '三杯宇治茶與茶包'
      assign pre = '籌備中'
      assign open = '開團中'
      assign closed = '已截止'
      assign pending = '團主、團購價、報名時間與台灣取貨方式確認後，將在此公布。'
      assign join = '我要跟團'
      assign invite = '用 LINE 邀朋友'
      assign invite_whatsapp = '用 WhatsApp 邀朋友'
      assign host_label = '本期團主'
      assign price_label = '團購價'
      assign deadline_name = '報名截止'
      assign pickup_label = '取貨方式'
      assign zone_label = '台灣時間'
      assign progress_name = '已登記的組數'
      assign progress_label = '已登記 {registered}／{target} 組'
      assign remaining_label = '再 {remaining} 組達成門檻'
      assign goal_met = '已達成團門檻'
      assign terms = '付款與未成團說明'
      assign how = '從跟團到取貨'
      assign steps = '從團主的頁面報名|截止後確認是否成團，成團後通知付款|從日本集中出貨給台灣團主|依團主通知在台灣取貨' | split: '|'
      assign demo_label = '網站示範 · 非正式開團'
      assign demo_join = '正式開團時會前往團主的報名頁。示範不收集報名資料，也不會收款。'
      assign demo_invite = '正式開團時可透過 LINE 分享本團連結。這裡是邀請訊息示範。'
      assign demo_invite_whatsapp = '正式開團時可透過 WhatsApp 分享本團連結。這裡是邀請訊息示範。'
      assign demo_date = '12/06（日）22:00'
      assign demo_host = '台北小林（示範團主）'
      assign demo_pickup = '台北面交'
      assign demo_note = '想試試三種宇治茶，可以先泡煎茶，再比較玉露與碾茶。'
      assign demo_terms = '成團後通知付款。若未成團，無須付款。'
      assign share_intro = '一起團購宇治茶！'
      assign image_label = 'AI 生成示意圖'
  endcase
  if demo
    assign campaign_price = 'NT$980'
    assign target = 30
    assign registered = 18
    assign deadline_label = demo_date
    assign campaign_pickup = demo_pickup
    assign campaign_host = demo_host
    assign campaign_note = demo_note
    assign payment_terms = demo_terms
  endif
  assign remaining = target | minus: registered | at_least: 0
  assign progress_value = registered | at_most: target
  assign progress_text = progress_label | replace: '{registered}', registered | replace: '{target}', target
  assign remaining_text = remaining_label | replace: '{remaining}', remaining
  assign share_message = share_intro | append: ' ' | append: title
  assign whatsapp_message = share_message | append: ' ' | append: public_share_url
-%}

<div class="tsukino-editorial">
  <section class="tsg-hero tsg-shell" id="{{ section_key | escape }}" aria-labelledby="{{ section_key | escape }}-title"{% if accepting and demo == false %} data-tsg-close-at="{{ deadline_epoch }}" data-closed-label="{{ closed | escape }}"{% endif %}>
    <div class="tsg-copy">
      <div class="tsg-campaign-flags">
        <p class="tsg-kicker">{{ group | escape }}</p>
        <p class="tsg-state" data-campaign-status>{% if demo %}{{ demo_label | escape }}{% elsif accepting %}{{ open | escape }}{% elsif campaign_ready %}{{ closed | escape }}{% else %}{{ pre | escape }}{% endif %}</p>
      </div>
      <h1 id="{{ section_key | escape }}-title">{{ title | escape }}</h1>
      <p class="tsg-lead">{{ desc | escape }}</p>
      {%- if demo or campaign_ready -%}
        <p class="tsg-campaign-host"><span>{{ host_label | escape }}</span> {{ campaign_host | escape }}</p>
        <dl class="tsg-campaign-facts">
          <div><dt>{{ price_label | escape }}</dt><dd>{{ campaign_price | escape }}</dd></div>
          <div><dt>{{ deadline_name | escape }} · {{ zone_label | escape }}</dt><dd>{% if demo %}{{ deadline_label | escape }}{% else %}<time datetime="{{ deadline | escape }}">{{ deadline_label | escape }}</time>{% endif %}</dd></div>
          <div><dt>{{ pickup_label | escape }}</dt><dd>{{ campaign_pickup | escape }}</dd></div>
        </dl>
        <div class="tsg-progress">
          <div class="tsg-progress-copy">
            <strong id="{{ section_key | escape }}-progress">{{ progress_text | escape }}</strong>
            {%- if remaining == 0 -%}<span>{{ goal_met | escape }}</span>{%- elsif accepting or demo -%}<span data-campaign-open-only>{{ remaining_text | escape }}</span>{%- endif -%}
          </div>
          <progress aria-label="{{ progress_name | escape }}" aria-describedby="{{ section_key | escape }}-progress" value="{{ progress_value }}" max="{{ target }}">{{ progress_text | escape }}</progress>
        </div>
        {%- if demo -%}
          <div class="tsg-campaign-actions">
            <details>
              <summary class="tsg-button">{{ join | escape }} <span aria-hidden="true">↗</span></summary>
              <p class="tsg-demo-message">{{ demo_join | escape }}</p>
            </details>
            <details>
              <summary class="tsg-button tsg-button-outline">{{ invite | escape }}</summary>
              <p class="tsg-demo-message">{{ demo_invite | escape }} <strong>{{ share_message | escape }}</strong></p>
            </details>
            <details>
              <summary class="tsg-button tsg-button-outline">{{ invite_whatsapp | escape }}</summary>
              <p class="tsg-demo-message">{{ demo_invite_whatsapp | escape }} <strong>{{ share_message | escape }}</strong></p>
            </details>
          </div>
        {%- elsif accepting -%}
          <div class="tsg-campaign-actions" data-campaign-open-only>
            <a class="tsg-button" href="{{ campaign.campaign_url | escape }}">{{ join | escape }} <span aria-hidden="true">↗</span></a>
            <a class="tsg-button tsg-button-outline" href="https://social-plugins.line.me/lineit/share?url={{ public_share_url | url_encode }}&amp;text={{ share_message | url_encode }}" target="_blank" rel="noopener noreferrer">{{ invite | escape }}</a>
            <a class="tsg-button tsg-button-outline" href="https://wa.me/?text={{ whatsapp_message | url_encode }}" target="_blank" rel="noopener noreferrer">{{ invite_whatsapp | escape }}</a>
          </div>
        {%- endif -%}
      {%- else -%}
        <p class="tsg-pending">{{ pending | escape }}</p>
      {%- endif -%}
    </div>
    <figure class="tsg-hero-media">
      <img src="{{ 'tsukino-ja-hero.jpg' | asset_url }}" width="1200" height="800" fetchpriority="high" alt="{{ heroAlt | escape }}">
      <figcaption>{{ image_label | escape }}</figcaption>
    </figure>
  </section>
  {%- if demo or campaign_ready -%}
    <section class="tsg-host tsg-shell" aria-labelledby="{{ section_key | escape }}-host">
      {%- if campaign.campaign_host_photo != blank and demo == false -%}
        <figure>{{ campaign.campaign_host_photo | image_url: width: 320 | image_tag: widths: '160, 240, 320', sizes: '104px', loading: 'lazy', alt: campaign_host }}</figure>
      {%- endif -%}
      <div>
        <p class="tsg-kicker">{{ host_label | escape }}</p>
        <h2 id="{{ section_key | escape }}-host">{{ campaign_host | escape }}</h2>
        <blockquote>{{ campaign_note | escape | newline_to_br }}</blockquote>
      </div>
    </section>
  {%- endif -%}
  {% render 'tsukino-ja-catalog', language: language, section_key: section_key %}
  <section class="tsg-delivery" aria-labelledby="{{ section_key | escape }}-delivery">
    <div class="tsg-shell">
      <h2 id="{{ section_key | escape }}-delivery">{{ how | escape }}</h2>
      <ol>{% for step in steps %}<li>{{ step | escape }}</li>{% endfor %}</ol>
      {%- if demo or campaign_ready -%}
        <details class="tsg-terms"><summary>{{ terms | escape }}</summary><p>{{ payment_terms | escape | newline_to_br }}</p></details>
      {%- endif -%}
    </div>
  </section>
</div>
{% schema %}
{
  "name": "Tsukino group buy",
  "enabled_on": {
    "templates": [
      "index"
    ]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "campaign_demo",
      "label": "Show the sample campaign (no signups)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "campaign_open",
      "label": "Enable Taiwan group buy",
      "default": false
    },
    {
      "type": "url",
      "id": "campaign_url",
      "label": "Organizer signup page"
    },
    {
      "type": "url",
      "id": "campaign_share_url",
      "label": "Optional public campaign landing page to share"
    },
    {
      "type": "text",
      "id": "campaign_host",
      "label": "Organizer name"
    },
    {
      "type": "image_picker",
      "id": "campaign_host_photo",
      "label": "Organizer photo"
    },
    {
      "type": "textarea",
      "id": "campaign_host_note",
      "label": "Organizer’s recommendation"
    },
    {
      "type": "text",
      "id": "campaign_price",
      "label": "Group-buy price and currency (e.g. NT$980)"
    },
    {
      "type": "text",
      "id": "campaign_deadline",
      "label": "Deadline (Taiwan time)",
      "info": "Use the format 2026-12-06T22:00:00+08:00."
    },
    {
      "type": "number",
      "id": "campaign_target_sets",
      "label": "Minimum sets to form the group"
    },
    {
      "type": "number",
      "id": "campaign_registered_sets",
      "label": "Sets registered",
      "default": 0
    },
    {
      "type": "text",
      "id": "campaign_delivery",
      "label": "Pickup or delivery method and area"
    },
    {
      "type": "textarea",
      "id": "refund_terms",
      "label": "Payment terms and what happens if the group falls short"
    }
  ],
  "presets": [
    {
      "name": "Tsukino group buy"
    }
  ]
}
{% endschema %}
