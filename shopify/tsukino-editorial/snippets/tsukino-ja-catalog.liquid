<section class="tsg-compare tsg-shell" id="{{ section_key | escape }}-teas" aria-labelledby="{{ section_key | escape }}-catalog" data-tsg-filter data-result-label="{{ result_label | escape }}">
  <div class="tsg-catalog-heading">
    <h2 id="{{ section_key | escape }}-catalog">{{ catalog_title | escape }}</h2>
    <a class="tsg-link" href="https://www.ja-town.com/shop/c/c4305_sgn/" target="_blank" rel="noopener noreferrer">{{ source_label | escape }} <span aria-hidden="true">↗</span></a>
  </div>
  <div class="tsg-catalog-controls" data-tea-filters hidden>
    <div class="tsg-filter-list" role="group" aria-labelledby="{{ section_key | escape }}-catalog">
      {%- for filter in filter_keys -%}
        <button class="tsg-filter" type="button" data-tea-filter="{{ filter }}" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}">{{ filter_labels[forloop.index0] | escape }}</button>
      {%- endfor -%}
    </div>
    <label class="tsg-screen-reader" for="{{ section_key | escape }}-search">{{ search_label | escape }}</label>
    <input class="tsg-search" id="{{ section_key | escape }}-search" type="search" data-tea-search placeholder="{{ search_label | escape }}">
  </div>
  <p class="tsg-catalog-count" data-tea-filter-status role="status" hidden></p>
  <p class="tsg-catalog-count" data-tea-empty hidden>{{ empty_label | escape }}</p>
  <div class="tsg-grid tsg-catalog-grid">
    {%- assign records = entries | strip | newline_to_br | split: '<br />' -%}
    {%- for line in records -%}
      {%- liquid
        assign record = line | strip | split: '|'
        assign code = record[0]
        if code == blank
          continue
        endif
        assign tags = record[1]
        assign japanese_title = record[2]
        case language
          when 'ja'
            assign name = japanese_title
          when 'en'
            assign name = record[4]
          else
            assign name = record[3]
        endcase
        assign picture = tags | split: ' ' | last
        if picture == 'sets'
          assign picture = 'gifts'
        endif
        if forloop.first
          assign picture = 'hero'
        endif
        assign filename = 'tsukino-ja-' | append: picture | append: '.jpg'
      -%}
      <article class="tsg-tea tsg-catalog-card" data-tea-uses="{{ tags | escape }}" data-tea-search-text="{{ name | append: ' ' | append: japanese_title | escape }}" data-item-code="{{ code | escape }}">
        <figure>
          <img src="{{ filename | asset_url }}" alt="" width="{% if forloop.first %}1200{% else %}768{% endif %}" height="{% if forloop.first %}800{% else %}512{% endif %}" loading="lazy">
          <figcaption>{{ image_label | escape }}</figcaption>
        </figure>
        <div class="tsg-catalog-card-body">
          {%- if forloop.first -%}<p class="tsg-catalog-featured">{{ featured_label | escape }}</p>{%- endif -%}
          <h3>{{ name | escape }}</h3>
          {%- if language != 'ja' -%}
            <details class="tsg-terms tsg-original-name"><summary>{{ original_label | escape }}</summary><p lang="ja">{{ japanese_title | escape }}</p></details>
          {%- endif -%}
          {%- if forloop.first -%}
            <a class="tsg-link" href="#{{ section_key | escape }}">{{ see_campaign | escape }} <span aria-hidden="true">↑</span></a>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>
