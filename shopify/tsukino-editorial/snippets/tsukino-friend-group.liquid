{%- liquid
  case language
    when 'ja'
      assign started = 'グループを作成しました'
      assign invited = '友達から招待が届きました'
      assign formed = 'グループが成立しました'
      assign expired = '期限切れで不成立'
      assign started_note = '友達1人が期限内に同じセットをデモ購入すると成立します。'
      assign invited_note = '友達が先にデモ購入しました。同じセットをデモ購入すると2人で成立します。'
      assign formed_note = '2人のデモ購入が確定しました。'
      assign expired_note = 'デモ購入をキャンセルし、返金済みとして表示します。実際の決済はありません。'
      assign progress_label = '{count}／2人が購入済み'
      assign remaining_label = '残り'
      assign invitation = '招待リンク'
      assign result_link = '友達に成立結果を返すリンク'
      assign copy = 'リンクをコピー'
      assign copied = 'コピーしました'
      assign open_invite = '友達として開く'
      assign share_line = 'LINEで送る'
      assign share_whatsapp = 'WhatsAppで送る'
      assign invite_message = '宇治茶ティーバッグ3種セットを一緒に買いませんか？'
      assign expiry_example = '期限切れの見本を見る'
      assign join_label = 'このグループに参加する'
      assign unavailable = 'このグループの募集は終了しました。'
    when 'en'
      assign started = 'Your group is open'
      assign invited = 'A friend invited you'
      assign formed = 'Your group is complete'
      assign expired = 'Group expired'
      assign started_note = 'Invite one friend to make a demo purchase of the same tea set before the timer runs out.'
      assign invited_note = 'Your friend already made a demo purchase. Buy the same set to complete the group together.'
      assign formed_note = 'Both demo purchases are confirmed.'
      assign expired_note = 'The demo purchase is shown as canceled and refunded. No real payment was collected.'
      assign progress_label = '{count} of 2 people purchased'
      assign remaining_label = 'Time left'
      assign invitation = 'Invite link'
      assign result_link = 'Link to send the result to your friend'
      assign copy = 'Copy link'
      assign copied = 'Copied'
      assign open_invite = 'Open as a friend'
      assign share_line = 'Share on LINE'
      assign share_whatsapp = 'Share on WhatsApp'
      assign invite_message = 'Want to buy a three-variety Uji tea bag set together?'
      assign expiry_example = 'See an expired example'
      assign join_label = 'Join this group'
      assign unavailable = 'This group is closed.'
    else
      assign started = '已開團'
      assign invited = '朋友邀請你跟團'
      assign formed = '團購已成立'
      assign expired = '已截止，未成團'
      assign started_note = '分享連結給一位好友。對方在倒數結束前示範購買同一款茶組，即可成團。'
      assign invited_note = '朋友已完成示範購買。試買同一款茶組，即可兩人成團。'
      assign formed_note = '兩筆示範購買均已確認。'
      assign expired_note = '示範訂單顯示為已取消並退款。此次示範未實際收款。'
      assign progress_label = '{count}／2 人已購買'
      assign remaining_label = '剩餘時間'
      assign invitation = '邀請連結'
      assign result_link = '分享成團結果給朋友的連結'
      assign copy = '複製連結'
      assign copied = '已複製'
      assign open_invite = '以朋友身分開啟'
      assign share_line = '透過 LINE 分享'
      assign share_whatsapp = '透過 WhatsApp 分享'
      assign invite_message = '一起團購宇治茶包三款組嗎？'
      assign expiry_example = '查看逾期未成團示範'
      assign join_label = '加入這個團購'
      assign unavailable = '此團購已結束。'
  endcase
-%}
<div class="tsg-friend-group" data-tsg-friend-status
  data-join-label="{{ join_label | escape }}" data-unavailable="{{ unavailable | escape }}"
  data-progress-template="{{ progress_label | escape }}" data-invite-message="{{ invite_message | escape }}" hidden>
  <div role="status">
    <p data-group-copy="started" hidden><strong>{{ started | escape }}</strong><br>{{ started_note | escape }}</p>
    <p data-group-copy="invited" hidden><strong>{{ invited | escape }}</strong><br>{{ invited_note | escape }}</p>
    <p data-group-copy="formed" hidden><strong>{{ formed | escape }}</strong><br>{{ formed_note | escape }}</p>
    <p data-group-copy="expired" hidden><strong>{{ expired | escape }}</strong><br>{{ expired_note | escape }}</p>
  </div>
  <div class="tsg-friend-metrics">
    <span data-group-progress></span>
    <span data-group-timer hidden>{{ remaining_label | escape }} <time></time></span>
  </div>
  <div data-group-share hidden>
    <label>
      <span data-group-invite-label>{{ invitation | escape }}</span>
      <span data-group-result-label hidden>{{ result_link | escape }}</span>
      <input type="url" readonly>
    </label>
    <div class="tsg-friend-actions">
      <button class="tsg-button tsg-button-outline" type="button" data-copy-link>{{ copy | escape }}</button>
      <span data-copy-status role="status" hidden>{{ copied | escape }}</span>
      <a class="tsg-link" data-group-try target="_blank" rel="noopener">{{ open_invite | escape }}</a>
      <a class="tsg-link" data-group-line target="_blank" rel="noopener noreferrer">{{ share_line | escape }}</a>
      <a class="tsg-link" data-group-whatsapp target="_blank" rel="noopener noreferrer">{{ share_whatsapp | escape }}</a>
    </div>
  </div>
  <a class="tsg-link" data-group-expired-example hidden>{{ expiry_example | escape }}</a>
</div>
