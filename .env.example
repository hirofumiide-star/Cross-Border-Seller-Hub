# Copy to .env on the machine running the scripts. Never commit actual values.
# Shopify must be the development store; production stores are rejected.
SHOPIFY_DEV_STORE=uji-tsukino-sabo-demo.myshopify.com

# Use either the access token, or the client ID and secret of an app installed
# in this same organization's development store.
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# These credentials belong to OPENLOGI's DEMO environment only.
# The account code is shown in the OPENLOGI demo portal (example: TS001).
OPENLOGI_DEMO_ACCOUNT=
OPENLOGI_DEMO_TOKEN=
